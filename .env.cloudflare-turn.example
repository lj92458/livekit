# Cloudflare TURN Configuration Example
# Copy this file to .env and fill in your actual values

# Cloudflare TURN Key ID (required)
# Get it from: https://dash.cloudflare.com/ > Turn
CF_TURN_KEY_ID=your-cloudflare-turn-key-id-here

# Cloudflare API Token (required)
# Create a token with "Turn" permission at: https://dash.cloudflare.com/profile/api-tokens
CF_TURN_API_TOKEN=your-cloudflare-api-token-here

# TURN Credential TTL in seconds (optional)
# Default: 86400 (24 hours)
# Recommended: 86400 to 604800 (1 day to 7 days)
CF_TURN_TTL=86400

# LiveKit Configuration
LIVEKIT_KEYS=devkey:secret
LIVEKIT_REGION=us-west-1
LIVEKIT_NODE_IP=127.0.0.1
LIVEKIT_LOGGING_LEVEL=info
LIVEKIT_LOGGING_PION_LEVEL=error
